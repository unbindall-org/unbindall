# Local Docker quick start only. Do not reuse these credentials in a deployment.
POSTGRES_DB=unbindall
POSTGRES_USER=unbindall
POSTGRES_PASSWORD=unbindall-local-only

# If you change APP_PORT, use the same port in AUTH_URL.
APP_PORT=3000
AUTH_URL=http://localhost:3000
AUTH_EXPECTED_HOST=localhost
AUTH_TRUST_HOST=true
TRUSTED_PROXY_COUNT=1
AUTH_SECRET=unbindall-local-docker-only-secret-do-not-use-in-production

# Optional sign-in providers. Registration with email/password works without them.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
STEAM_WEB_API_KEY=
