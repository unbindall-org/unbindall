{
  "name": "unbindall",
  "version": "0.1.0",
  "description": "Open-source CS2 autoexec and config generator",
  "keywords": [
    "counter-strike-2",
    "cs2",
    "autoexec",
    "config-generator"
  ],
  "homepage": "https://github.com/unbindall-org/unbindall#readme",
  "bugs": {
    "url": "https://github.com/unbindall-org/unbindall/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbindall-org/unbindall.git"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next typegen && tsc --noEmit && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://unbindall:unbindall@127.0.0.1:55432/unbindall_test} vitest run --config vitest.integration.config.mts",
    "test:e2e": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://unbindall:unbindall@127.0.0.1:55432/unbindall_test} playwright test",
    "test:db:up": "docker compose -f compose.test.yml up -d --wait db",
    "test:db:down": "docker compose -f compose.test.yml down --volumes --remove-orphans",
    "test:container": "bash tests/container/smoke.sh",
    "test:load": "node tests/load/basic-load.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:community": "node scripts/seed-community.mjs",
    "db:studio": "drizzle-kit studio",
    "redis:start": "bash scripts/dev/redis.sh start",
    "redis:stop": "bash scripts/dev/redis.sh stop",
    "redis:ensure": "bash scripts/dev/redis.sh ensure",
    "redis:status": "bash scripts/dev/redis.sh status"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.102.7",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "i18next": "^26.4.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.12",
    "redis": "^5.12.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.6",
    "esbuild": "^0.28.0",
    "eslint": "9.37.0",
    "eslint-config-next": "16.3.3",
    "shadcn": "^4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.15.0"
}
