# Pooled Neon URL for the running application (hostname contains `-pooler`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unbindall
# Direct Neon URL without `-pooler`, used only for Drizzle migrations.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/unbindall
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
# In production, the exact allowed hostname from AUTH_URL (without scheme or port).
AUTH_EXPECTED_HOST=localhost
AUTH_TRUST_HOST=true
# Number of controlled reverse-proxy hops before the app; only with AUTH_TRUST_HOST=true.
TRUSTED_PROXY_COUNT=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated additional hosts allowed to access `next dev`, e.g. a LAN device.
NEXT_ALLOWED_DEV_ORIGINS=

# Optional HTTPS collector for structured error events. Without a collector,
# the same events are still emitted as JSON lines on stderr.
ERROR_REPORTING_ENDPOINT=
ERROR_REPORTING_TOKEN=
# Optional release/commit identifier included in error events.
APP_VERSION=

# Central Redis for atomic rate limits. Required in production.
REDIS_URL=redis://localhost:6379

# Discord Developer Portal → OAuth2. Local callback:
# http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Steam Community Web API key from https://steamcommunity.com/dev/apikey
# Steam sign-in uses OpenID 2.0; no callback registration is needed there.
STEAM_WEB_API_KEY=
