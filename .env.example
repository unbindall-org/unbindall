# Gepoolte Neon-URL für die laufende Anwendung (Hostname enthält `-pooler`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/unbindall
# Direkte Neon-URL ohne `-pooler` ausschließlich für Drizzle-Migrationen.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5432/unbindall
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
# In Produktion exakt der erlaubte Hostname aus AUTH_URL (ohne Schema/Port).
AUTH_EXPECTED_HOST=localhost
AUTH_TRUST_HOST=true
# Anzahl kontrollierter Reverse-Proxy-Hops vor der App; nur bei AUTH_TRUST_HOST=true.
TRUSTED_PROXY_COUNT=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated additional hosts allowed to access `next dev`, e.g. a LAN device.
NEXT_ALLOWED_DEV_ORIGINS=

# Optional HTTPS collector for structured error events. Without a collector,
# the same events are still emitted as JSON lines on stderr.
ERROR_REPORTING_ENDPOINT=
ERROR_REPORTING_TOKEN=
# Optional release/commit identifier included in error events.
APP_VERSION=

# Zentraler Redis für atomare Rate-Limits. In Produktion zwingend erforderlich.
REDIS_URL=redis://localhost:6379

# Discord Developer Portal → OAuth2. Callback lokal:
# http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Steam Community Web API Key von https://steamcommunity.com/dev/apikey
# Steam verwendet für den Login OpenID 2.0; eine Callback-Registrierung ist dort nicht nötig.
STEAM_WEB_API_KEY=
